# ==============================================================================
# OpenIaC Git Ignore Rules
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ansible specific
*.retry
*.vault
ansible.log
group_vars/all.yml.bak

# SSH keys and certs
*.pem
*.key
*.pub
private_keys/
certs/

# Packager Artifacts (Air-gapped)
# Do not commit large tarballs, RPMs, wheels, or container image dumps to Git
artifacts/
packager/artifacts/
packager/downloads/
*.tar.gz
*.tar
*.iso
*.img
*.qcow2

# Temp and Logs
tmp/
*.log

# Editor directories
.idea/
.vscode/
*.swp
*.swo

# Vagrant & VirtualBox specific
.vagrant/
Vagrantfile.local
*.vdi
*.vmdk
*.box