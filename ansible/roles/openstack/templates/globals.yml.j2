---
# OpenIaC Kolla-Ansible Configuration (Generated dynamically)

kolla_base_distro: "rocky"
kolla_install_type: "source"

# Network Interfaces
network_interface: "{{ openstack_network_interface | default('eth1') }}"
neutron_external_interface: "{{ openstack_neutron_external_interface | default('eth2') }}"

# VIP
kolla_internal_vip_address: "{{ openstack_vip_address | default('192.168.100.250') }}"

# Enabled Services
enable_cinder: "yes"
enable_cinder_backend_lvm: "yes"
enable_horizon: "yes"
enable_neutron_provider_networks: "yes"

# Air-gapped Support
{% if airgapped_mode | default(false) | bool %}
docker_registry: "{{ local_registry | default('localhost:5000') }}"
docker_registry_insecure: "yes"
{% endif %}
