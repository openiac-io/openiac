# -*- mode: ruby -*-
# vi: set ft=ruby :

# ==============================================================================
# OpenIaC: OpenStack Cluster Test Environment (Controller + Compute)
# ==============================================================================

# ------------------------------------------------------------------------------
# 💻 OS Selection
# ------------------------------------------------------------------------------
TARGET_OS = "bento/rockylinux-9"

Vagrant.configure("2") do |config|
  config.vm.box = TARGET_OS
  config.vm.synced_folder "../../", "/openiac", type: "virtualbox"

  # Common VirtualBox settings
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "4096"
    vb.cpus = 2
  end

  # SSH Fix for seamless local Ansible testing
  config.vm.provision "shell", inline: <<-SHELL
    echo "Configuring SSH for seamless Ansible testing..."
    sed -i 's/^PasswordAuthentication no/PasswordAuthentication yes/g' /etc/ssh/sshd_config
    sed -i 's/^#PasswordAuthentication yes/PasswordAuthentication yes/g' /etc/ssh/sshd_config
    systemctl restart sshd || true
  SHELL

  # ----------------------------------------------------------------------------
  # 1. OpenStack Controller Node (controller-01)
  # ----------------------------------------------------------------------------
  config.vm.define "controller-01" do |node|
    node.vm.hostname = "controller-01"
    # Management network IP
    node.vm.network "private_network", ip: "192.168.100.30"
  end

  # ----------------------------------------------------------------------------
  # 2. OpenStack Compute Node (compute-01)
  # ----------------------------------------------------------------------------
  config.vm.define "compute-01" do |node|
    node.vm.hostname = "compute-01"
    node.vm.network "private_network", ip: "192.168.100.31"
    
    # Attach a secondary 40GB disk for Cinder Volumes
    node.vm.provider "virtualbox" do |vb|
      disk_path = "./compute-cinder-volumes.vdi"
      unless File.exist?(disk_path)
        vb.customize ["createmedium", "disk", "--filename", disk_path, "--size", "40960"]
      end
      vb.customize ["storageattach", :id, "--storagectl", "SATA Controller", "--port", "1", "--device", "0", "--type", "hdd", "--medium", disk_path]
    end
  end

end
