# -*- mode: ruby -*-
# vi: set ft=ruby :

# ==============================================================================
# OpenIaC: Standard Upstream Kubernetes (K8s & KubeVirt) Test Environment
# ==============================================================================

TARGET_OS = "bento/rockylinux-9"

Vagrant.configure("2") do |config|
  config.vm.box = TARGET_OS

  # Share the parent 'openiac' directory to /openiac inside the VMs
  config.vm.synced_folder "../../", "/openiac", type: "virtualbox"

  # Common VirtualBox settings for all nodes
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "4096"
    vb.cpus = 2
  end

  # ----------------------------------------------------------------------------
  # [Micro-UX] Enable Password Authentication for seamless local Ansible testing
  # ----------------------------------------------------------------------------
  config.vm.provision "shell", inline: <<-SHELL
    echo "Configuring SSH for seamless Ansible testing..."
    sed -i 's/^PasswordAuthentication no/PasswordAuthentication yes/g' /etc/ssh/sshd_config
    sed -i 's/^#PasswordAuthentication yes/PasswordAuthentication yes/g' /etc/ssh/sshd_config
    systemctl restart sshd || true
  SHELL

  # ----------------------------------------------------------------------------
  # 1. Kubernetes Control Plane Node (cp-01)
  # ----------------------------------------------------------------------------
  config.vm.define "cp-01" do |node|
    node.vm.hostname = "cp-01"
    node.vm.network "private_network", ip: "192.168.56.10"
  end

  # ----------------------------------------------------------------------------
  # 2. Kubernetes Worker Node 1 (worker-01)
  # ----------------------------------------------------------------------------
  config.vm.define "worker-01" do |node|
    node.vm.hostname = "worker-01"
    node.vm.network "private_network", ip: "192.168.56.20"
  end

  # ----------------------------------------------------------------------------
  # 3. Kubernetes Worker Node 2 (worker-02)
  # ----------------------------------------------------------------------------
  config.vm.define "worker-02" do |node|
    node.vm.hostname = "worker-02"
    node.vm.network "private_network", ip: "192.168.56.21"
  end
end
